# ============================================================
# Docker 部署专用配置（复制成项目根目录的 .env，docker compose 会自动读）
#
# ⚠️ 本地开发（前后端分别 npm run dev）不要用这份文件，
#    请复制 server/.env.example → server/.env，里面的 CORS_ORIGIN 是 5173（Vite 端口）。
#
# 这份文件里的端口是 Docker 模式下的访问地址：容器里的前端由 Nginx 托管在 8080，
# 没有 Vite，所以 CORS_ORIGIN 是 8080 而不是 5173。
#
# 直接跑 start/docker-unix.sh 的话，下面三个密码会自动生成并写进 .env，不用手动准备。
# 手动执行 docker compose up 时，DB_PASSWORD / JWT_SECRET / ADMIN_PASSWORD 必须自己填，
# 缺任何一个 compose 都会报错退出。
# ============================================================

# 前端对外端口
WEB_PORT=8080
# 数据库名
DB_NAME=nextlaunch_hub

# MySQL root 密码，后端连接也用它。生成方式：openssl rand -hex 16
# 只在数据库卷为空时生效，库建好之后再改不会同步到已有数据库
DB_PASSWORD=请换成自己生成的随机串

# 登录态签名密钥，至少 32 位。生成方式：openssl rand -hex 32
# 泄露等于任何人都能伪造管理员登录，且改密码无法让已伪造的登录态失效
JWT_SECRET=请换成自己生成的随机串

# 首次部署时给 admin 设置的密码。生成方式：openssl rand -hex 8
ADMIN_PASSWORD=请换成自己生成的随机串
# 想让 .env 里的 ADMIN_PASSWORD 强制覆盖页面上已改过的管理员密码，改成 true
RESET_ADMIN_PASSWORD=false

# 登录态有效期
JWT_EXPIRES_IN=7d
# 允许访问的站点地址，多个用英文逗号分隔；局域网访问要加上实际地址
CORS_ORIGIN=http://localhost:8080
# 走 HTTPS 时改成 true，否则登录 Cookie 会失效
COOKIE_SECURE=false
# 后端前面有几层反向代理。Docker 模式下前面只有一层 Nginx，所以是 1；
# 直接跑 node src/server.js（本地开发）没有代理，必须写 false，
# 否则客户端可以伪造 X-Forwarded-For 绕过限流、污染求助单里的来源 IP。
TRUST_PROXY=1
