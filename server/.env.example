PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CONNECT_TIMEOUT_MS=5000
DB_USER=root
DB_PASSWORD=123456
DB_NAME=nextlaunch_hub
# 必须换成自己生成的随机串：openssl rand -hex 32
# 留着这行示例值的话，服务启动时会直接报错退出
JWT_SECRET=请运行-openssl-rand-hex-32-生成随机串
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
# 本地开发是浏览器直连后端，没有反向代理，保持 false
TRUST_PROXY=false
# V2 附件存储目录与单文件上限（默认 5MB）
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=5242880
